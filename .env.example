# Copy to .env and fill in what you have. NEER runs with NO keys (rules fallback).
GROQ_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Order of LLM providers to try; 'rules' is the always-working deterministic fallback
NEER_LLM_CHAIN=groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash,ollama:qwen2.5:7b,rules
# mcp = agents call tools through the 4 MCP servers; direct = in-process (fallback / tests)
NEER_TOOL_MODE=direct
